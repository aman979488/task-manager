<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/task_widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/task_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/task_widget_name"
        android:textColor="#6B5800"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/task_widget_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/task_widget_default_summary"
        android:textColor="#594D25"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="#806B5800" />

    <TextView
        android:id="@+id/task_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/task_widget_all_caught_up"
        android:textColor="#594D25"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/task_widget_task_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#242424"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/task_widget_task_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#242424"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/task_widget_task_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#242424"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
