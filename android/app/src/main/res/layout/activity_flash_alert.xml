<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/flash_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="36dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <!-- Top Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.2"
            android:text="⚡ FLASH MESSAGE"
            android:textColor="@color/flash_yellow"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Big Clock Display -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/textClockTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="hh:mm"
                android:format24Hour="HH:mm"
                android:textColor="@color/flash_text_white"
                android:textSize="58sp"
                android:fontFamily="sans-serif-light" />

            <TextClock
                android:id="@+id/textClockAmPm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="12dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="@color/flash_text_muted"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pulsing Bolt Icon -->
        <FrameLayout
            android:id="@+id/layoutIconPulse"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_flash_icon_circle">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:contentDescription="Flash alert icon"
                android:src="@drawable/ic_flash_bolt" />
        </FrameLayout>

        <!-- Sender Name -->
        <TextView
            android:id="@+id/tvSender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Message from Staff"
            android:textColor="@color/flash_text_muted"
            android:textSize="16sp" />

        <!-- Message Body -->
        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Alert message text"
            android:textColor="@color/flash_text_white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Choose a response header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Choose a response"
            android:textColor="@color/flash_yellow"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Response Chips Container -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupResponses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFinished"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Finished"
                android:textColor="@color/flash_yellow_dark"
                app:chipBackgroundColor="@color/flash_yellow"
                app:chipCornerRadius="18dp"
                app:chipStrokeColor="@color/flash_yellow"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipInProcess"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="In process"
                android:textColor="@color/flash_yellow_dark"
                app:chipBackgroundColor="@color/flash_yellow"
                app:chipCornerRadius="18dp"
                app:chipStrokeColor="@color/flash_yellow"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWillTakeTime"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Will take time"
                android:textColor="@color/flash_yellow_dark"
                app:chipBackgroundColor="@color/flash_yellow"
                app:chipCornerRadius="18dp"
                app:chipStrokeColor="@color/flash_yellow"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipForgot"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forgot"
                android:textColor="@color/flash_yellow_dark"
                app:chipBackgroundColor="@color/flash_yellow"
                app:chipCornerRadius="18dp"
                app:chipStrokeColor="@color/flash_yellow"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOthers"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Others"
                android:textColor="@color/flash_yellow_dark"
                app:chipBackgroundColor="@color/flash_yellow"
                app:chipCornerRadius="18dp"
                app:chipStrokeColor="@color/flash_yellow"
                app:chipStrokeWidth="1dp" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Other response input box (shown when Others is selected) -->
        <LinearLayout
            android:id="@+id/layoutOtherResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etOtherResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_flash_edittext"
                android:hint="Type your response"
                android:lines="2"
                android:maxLines="3"
                android:padding="12dp"
                android:textColor="@color/flash_text_white"
                android:textColorHint="@color/flash_text_muted"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendOther"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Send response"
                android:textColor="@color/flash_yellow_dark"
                android:textStyle="bold"
                app:backgroundTint="@color/flash_yellow"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <!-- Spacer / Weight to push Got it button to bottom if extra space -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="20dp" />

        <!-- Status / Error text -->
        <TextView
            android:id="@+id/tvStatusError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="#FF5252"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/progressSubmitting"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginBottom="8dp"
            android:indeterminateTint="@color/flash_yellow"
            android:visibility="gone" />

        <!-- Got It Main Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGotIt"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Got it"
            android:textColor="@color/flash_yellow_dark"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@color/flash_yellow"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>
