rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.role;
    }

    function isManager() {
      return signedIn() && myRole() in ['superAdmin', 'admin', 'officeStaff'];
    }

    function isSelfRegistration(uid) {
      return signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'contactNo',
          'photoUrl',
          'role'
        ]) &&
        request.resource.data.keys().hasAll([
          'uid',
          'name',
          'email',
          'contactNo',
          'photoUrl',
          'role'
        ]) &&
        request.resource.data.uid == uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.name is string &&
        request.resource.data.contactNo is string &&
        (request.resource.data.photoUrl == null ||
          request.resource.data.photoUrl is string) &&
        request.resource.data.role == 'employee';
    }

    function myName() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.get('name', '');
    }

    function isTaskCreator() {
      return signedIn() &&
        resource.data.get('createdBy', {}).get('uid', '') == request.auth.uid;
    }

    function isTaskAssigneeOrMonitor() {
      return signedIn() && (
        resource.data.get('assigneeUids', []).hasAny([request.auth.uid]) ||
        resource.data.get('assigneeUid', '') == request.auth.uid ||
        resource.data.get('assignee', '') == myName() ||
        resource.data.get('assigneeNames', []).hasAny([myName()]) ||
        resource.data.get('monitorNames', []).hasAny([myName()]) ||
        resource.data.get('monitor', '') == myName()
      );
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelfRegistration(uid) || isManager();
      allow delete: if isManager();
      allow update: if isManager() ||
        (request.auth.uid == uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
    }

    match /map/{taskId} {
      allow create: if signedIn();
      allow read, update: if isManager() ||
        isTaskAssigneeOrMonitor() ||
        isTaskCreator();
      allow delete: if isManager();
    }

    match /notifications/{id} {
      allow create: if signedIn();
      allow read, update: if signedIn() &&
        resource.data.recipientUid == request.auth.uid;
    }

    match /flashMessages/{id} {
      allow create: if signedIn() &&
        request.resource.data.senderUid == request.auth.uid;
      allow read: if signedIn() &&
        (resource.data.recipientUid == request.auth.uid ||
         resource.data.senderUid == request.auth.uid);
      allow update: if signedIn() &&
        resource.data.recipientUid == request.auth.uid &&
        (
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'seenAt']) &&
            request.resource.data.status == 'seen'
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'status',
                'seenAt',
                'response',
                'respondedAt',
                'responseText'
              ]) &&
            request.resource.data.status == 'seen' &&
            !resource.data.keys().hasAny(['response']) &&
            request.resource.data.response in [
              'Finished',
              'In process',
              'Will take time',
              'Forgot',
              'Others'
            ] &&
            request.resource.data.respondedAt is timestamp &&
            (
              (
                request.resource.data.response == 'Others' &&
                request.resource.data.responseText is string &&
                request.resource.data.responseText.size() > 0 &&
                request.resource.data.responseText.size() <= 500
              ) ||
              (
                request.resource.data.response != 'Others' &&
                !request.resource.data.keys().hasAny(['responseText'])
              )
            )
          )
        );
    }

    match /flashTemplates/{id} {
      allow read: if signedIn();
      allow write: if isManager();
    }

    match /weeklyGoals/{goalId} {
      allow read: if signedIn() &&
        (isManager() || resource.data.userUid == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.userUid == request.auth.uid;
      allow update: if signedIn() &&
        resource.data.userUid == request.auth.uid &&
        request.resource.data.userUid == request.auth.uid;
      allow delete: if signedIn() &&
        resource.data.userUid == request.auth.uid;
    }

    match /{coll}/{doc} {
      allow read: if signedIn() &&
        coll in ['WorkType', 'projects', 'leads', 'cps'];
      allow write: if isManager() &&
        coll in ['WorkType', 'projects', 'leads', 'cps'];
    }
  }
}
